# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret-key

# Database Configuration (MySQL/MariaDB)
# Option 1: Use full DATABASE_URL
DATABASE_URL=mysql+pymysql://root:your_password@localhost/attendanceDB

# Option 2: Use individual parameters (recommended if password has special chars)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_NAME=attendanceDB

# Face Recognition Settings
FACE_DATA_DIR=data/faces
FACE_MODEL_DIR=data/models

# Attendance cooldown (prevent duplicate marking within X seconds)
ATTENDANCE_COOLDOWN_SECONDS=10

# Optional: Flask Environment (development/production)
# FLASK_ENV=development
